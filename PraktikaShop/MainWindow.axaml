<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="PraktikaShop.MainWindow"
        Icon="Images/logo.ico"
        Title="IvanPrime - Авторизация"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI">

    <Grid>
        <Border CornerRadius="15" 
                Background="#DDFFFFFF" 
                Margin="40"
                Padding="30"
                VerticalAlignment="Center"
                HorizontalAlignment="Center">
            <StackPanel Spacing="20" Width="300">
                <TextBlock Text="IvanPrime Магазин" 
                           FontSize="24" 
                           FontWeight="Bold" 
                           HorizontalAlignment="Center"
                           Foreground="#FF333333"
                           Margin="0,0,0,10"/>
                
                <TextBlock Text="Добро пожаловать!" 
                           FontSize="16"
                           HorizontalAlignment="Center"
                           Foreground="#FF555555"
                           Margin="0,0,0,20"/>
                <StackPanel Spacing="10">
                    <TextBlock Text="Логин" 
                               FontWeight="SemiBold"
                               Foreground="#FF333333"/>
                    <TextBox x:Name="LoginBox" 
                             Height="40"
                             Padding="10"
                             FontSize="14"
                             Background="#F5F5F5"
                             BorderThickness="1"
                             BorderBrush="#DDDDDD"
                             CornerRadius="5"/>
                    
                    <TextBlock Text="Пароль" 
                               FontWeight="SemiBold"
                               Foreground="#FF333333"
                               Margin="0,10,0,0"/>
                    <TextBox x:Name="PasswordBox" 
                             Height="40"
                             Padding="10"
                             FontSize="14"
                             Background="#F5F5F5"
                             BorderThickness="1"
                             BorderBrush="#DDDDDD"
                             CornerRadius="5"
                             PasswordChar="*"/>
                </StackPanel>
                
                <StackPanel Spacing="10" Margin="0,20,0,0">
                    <Button Content="Войти" 
                            Click="LoginClick" 
                            Height="40"
                            Background="#FFFFD700"
                            Foreground="#FF333333"
                            FontWeight="Bold"
                            BorderThickness="0"
                            CornerRadius="5"/>
                    
                    <Button Content="Регистрация" 
                            Click="RegistrationButton" 
                            Height="40"
                            Background="#FFFFD700"
                            Foreground="#FF333333"
                            FontWeight="Bold"
                            BorderThickness="0"
                            CornerRadius="5"/>
                    
                    <Button Content="Выйти" 
                            Click="ExitClick" 
                            Height="40"
                            Background="#FFFFD700"
                            Foreground="#FF333333"
                            FontWeight="Bold"
                            BorderThickness="0"
                            CornerRadius="5"/>
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>