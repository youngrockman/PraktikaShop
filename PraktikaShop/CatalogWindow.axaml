<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="PraktikaShop.CatalogWindow"
        x:CompileBindings="False"
        Icon="Images/logo.ico"
        Title="Каталог товаров"
        Background="#F8F9FA">

    <DockPanel LastChildFill="False">
        
        <Border DockPanel.Dock="Top" 
                Background="#2C3E50" 
                Height="60"
                CornerRadius="0,0,10,10"
                Padding="10">
            <TextBlock Text="Каталог товаров IvanPrime"
                       Foreground="White"
                       FontSize="20"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Border>
        
        <Border DockPanel.Dock="Top"
                Background="White"
                CornerRadius="10"
                Margin="10"
                Padding="10"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" 
                        HorizontalAlignment="Center" 
                        Spacing="15">
                <TextBox Width="200"
                         Watermark="Поиск товаров..."
                         x:Name="SeacrhBox"
                         FontSize="14"
                         Padding="8"
                         BorderThickness="1"
                         BorderBrush="#DDDDDD"/>
                
                <ComboBox Width="180" 
                          x:Name="OrderBox"
                          FontSize="14"
                          Padding="5"
                          BorderThickness="1"
                          BorderBrush="#DDDDDD">
                    <ComboBoxItem>По возрастанию</ComboBoxItem>
                    <ComboBoxItem>По убыванию</ComboBoxItem>
                </ComboBox>

                <ComboBox Width="180"
                          x:Name="ItemsBox"
                          FontSize="14"
                          Padding="5"
                          BorderThickness="1"
                          BorderBrush="#DDDDDD"/>
            </StackPanel>
        </Border>
        
        <ScrollViewer DockPanel.Dock="Top" Margin="10" Height="500">
            <ListBox x:Name="CatalogListBox" Background="Transparent" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="10" 
                                BorderThickness="1" 
                                BorderBrush="#E0E0E0"
                                CornerRadius="10" 
                                Padding="15"
                                Background="White">
                            <DockPanel>
                                <Border Width="100" Height="100"
                                        Background="#F5F5F5"
                                        CornerRadius="8"
                                        DockPanel.Dock="Left"
                                        Margin="0,0,15,0">
                                    <Image Source="{Binding ParseImage}" 
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Border>
                                
                                <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="{Binding ProductName}" 
                                               FontSize="16" 
                                               FontWeight="Bold"
                                               Foreground="#2C3E50"/>
                                    <TextBlock Text="{Binding Cost, StringFormat='Цена: {0} руб.'}"
                                               FontSize="14"
                                               Foreground="#27AE60"
                                               Margin="0,5,0,0"/>
                                    <TextBlock Text="{Binding Count, StringFormat='Остаток: {0} шт.'}" 
                                               FontSize="13"
                                               Foreground="#7F8C8D"/>
                                    <TextBlock Text="{Binding Discount, StringFormat='Скидка: {0}%'}" 
                                               FontSize="13"
                                               Foreground="#E74C3C"
                                               FontWeight="SemiBold"
                                               Margin="0,5,0,0"/>

                                    <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,10,0,0">
                                        <Button Content="В корзину" 
                                                Tag="{Binding ProductId}"
                                                Click="AddInBasket_Click"
                                                Background="#FFD700"
                                                Foreground="Black"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                CornerRadius="5"
                                                Width="120"
                                                Height="35"/>
                                        <Button Content="Удалить"
                                                Tag="{Binding ProductId}" 
                                                Click="DeleteProduct_Click"
                                                Background="#FFD700"
                                                Foreground="Black"
                                                FontWeight="Bold"
                                                BorderThickness="0"
                                                CornerRadius="5"
                                                Width="100"
                                                Height="35"/>
                                    </StackPanel>
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </ScrollViewer>
        
        <Border DockPanel.Dock="Bottom"
                Background="White"
                CornerRadius="10"
                Margin="10"
                Padding="10"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
                <Button Content="Выйти"
                        Click="Exit_Click"
                        Background="#FFD700"
                        Foreground="Black"
                        FontWeight="Bold"
                        BorderThickness="0"
                        CornerRadius="5"
                        Width="120"
                        Height="35"/>
                <Button Content="Корзина"
                        Click="BasketClick"
                        Background="#FFD700"
                        Foreground="Black"
                        FontWeight="Bold"
                        BorderThickness="0"
                        CornerRadius="5"
                        Width="120"
                        Height="35"/>
                <Button Content="Добавить товар"
                        Click="AddButton_Click"
                        Background="#FFD700"
                        Foreground="Black"
                        FontWeight="Bold"
                        BorderThickness="0"
                        CornerRadius="5"
                        Width="150"
                        Height="35"/>
            </StackPanel>
        </Border>

    </DockPanel>
</Window>
